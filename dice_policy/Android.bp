package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libdice_policy.defaults",
    crate_name: "dice_policy",
    defaults: ["avf_build_flags_rust"],
    edition: "2021",
    lints: "android",
    vendor_available: true,
}

rust_library_rlib {
    name: "libdice_policy_nostd",
    defaults: ["libdice_policy.defaults"],
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libciborium_nostd",
        "libcoset_nostd",
    ],
    prefer_rlib: true,
    no_stdlibs: true,
    min_sdk_version: "35",
}

rust_library {
    name: "libdice_policy",
    defaults: ["libdice_policy.defaults"],
    srcs: ["src/lib.rs"],
    host_supported: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.sdv.*",
    ],
    min_sdk_version: "35",
    rustlibs: [
        "libciborium",
        "libcoset",
    ],
}
